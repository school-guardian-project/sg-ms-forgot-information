# SQL Server shared instance (ADR-002) — same database other sg-db services use locally
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=SchoolGuardian;User Id=sa;Password=REPLACE_ME;TrustServerCertificate=True;

# JWT RS256 validation (ADR-008) — only the PUBLIC key is needed here, this service never signs tokens
Jwt__Issuer=school-guardian
Jwt__Audience=school-guardian-clients
Jwt__PublicKey="-----BEGIN PUBLIC KEY-----\n[REPLACE WITH THE PUBLIC KEY FROM iam-service]\n-----END PUBLIC KEY-----"

# OTP settings
Otp__CodeLength=6
Otp__ExpirationMinutes=10
Otp__MaxAttempts=5
Otp__MaxRequestsPerWindow=3
Otp__RequestWindowMinutes=10
Otp__ResetTokenExpirationMinutes=5
# Server-side secret mixed into every OTP hash — generate with: openssl rand -base64 32
Otp__HashPepper=REPLACE_ME

# Upstream services this microservice calls synchronously (temporary REST bridge, see DEC-002)
IdentityDirectory__IamServiceBaseUrl=http://iam-service:8080
IdentityDirectory__UserManagementServiceBaseUrl=http://ms-user-management:8080

# Email delivery (SMTP)
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=REPLACE_ME
Smtp__Password=REPLACE_ME
Smtp__FromAddress=no-reply@guardianescolar.com
Smtp__FromName=Guardian Escolar

# SMS delivery (Twilio REST API)
Sms__Provider=Twilio
Sms__AccountSid=REPLACE_ME
Sms__AuthToken=REPLACE_ME
Sms__FromNumber=+10000000000
