# Copy to .env. Keep this file out of Git; it contains credentials.
# Use the same SQL Server and database configured for ms-iam.
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=school-guardian;User Id=sa;Password=REPLACE_WITH_MSSQL_SA_PASSWORD;TrustServerCertificate=True;

# Must match INTERNAL_API_KEY in ../../ms-iam/.env. Generate a random 32-byte key.
INTERNAL_API_KEY=REPLACE_WITH_SHARED_RANDOM_KEY

# Generate a separate random 32-byte secret, e.g. openssl rand -base64 32.
OTP_HASH_PEPPER=REPLACE_WITH_RANDOM_SECRET

# Gmail: smtp.gmail.com / 587 / STARTTLS. Use an app password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD
SMTP_FROM=your-sender@gmail.com
CORS_ALLOWED_ORIGIN=http://localhost:4200
